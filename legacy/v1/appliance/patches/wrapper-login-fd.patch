+/*
+ * This binary exercises only source-matched constructor/destructor paths in
+ * a disposable, no-network rootfs. It initializes the same non-secret
+ * parser defaults as product main, but never invokes product main itself.
+ */
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int amdl_native_suppressed_fprintf(FILE *stream, const char *format, ...) {
+    (void)stream;
+    (void)format;
+    return 0;
+}
+
+#define fprintf amdl_native_suppressed_fprintf
+#define main amdl_native_product_main
+#include "main.c"
+#undef main
+#undef fprintf
+
+#define AMDL_NATIVE_ABI_CYCLES 10000
+#define AMDL_NATIVE_ABI_FIXTURE_CYCLES 5
+
+static unsigned long amdl_harness_http_message_created;
+static unsigned long amdl_harness_http_message_released;
+static unsigned long amdl_harness_url_request_created;
+static unsigned long amdl_harness_url_request_destroyed;
+
+static int amdl_native_write_literal(int descriptor, const char *literal) {
+    size_t offset = 0;
+    size_t length = strlen(literal);
+
+    while (offset < length) {
+        ssize_t written = write(descriptor, literal + offset, length - offset);
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        if (written <= 0) {
+            return 0;
+        }
+        offset += (size_t)written;
+    }
+    return 1;
+}
+
+static int amdl_native_stage(const char *stage) {
+    if (strcmp(stage, "parser") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE parser\n");
+    }
+    if (strcmp(stage, "device_fixture") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE device_fixture\n");
+    }
+    if (strcmp(stage, "two_factor_suffix") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE two_factor_suffix\n");
+    }
+    if (strcmp(stage, "init") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE init\n");
+    }
+    if (strcmp(stage, "init_ctx") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE init_ctx\n");
+    }
+    if (strcmp(stage, "provider") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE provider\n");
+    }
+    if (strcmp(stage, "store_error_code") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE store_error_code\n");
+    }
+    if (strcmp(stage, "cycles") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE cycles\n");
+    }
+    if (strcmp(stage, "fixture_server") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE fixture_server\n");
+    }
+    if (strcmp(stage, "fixture_cycles") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE fixture_cycles\n");
+    }
+    if (strcmp(stage, "complete") == 0) {
+        return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_STAGE complete\n");
+    }
+    return 0;
+}
+
+static int amdl_native_write_provider(const char *provider) {
+    return amdl_native_write_literal(STDERR_FILENO, "AMDL_NATIVE_ABI_PROVIDER ") &&
+           amdl_native_write_literal(STDERR_FILENO, provider) &&
+           amdl_native_write_literal(STDERR_FILENO, "\n");
+}
+
+static int amdl_native_provider_matches_any(const char *symbol,
+                                            const char *const *expected,
+                                            size_t expected_count,
+                                            const char *lookup_failure,
+                                            const char *owner_failure) {
+    Dl_info details;
+    const char *basename;
+    void *address = dlsym(RTLD_DEFAULT, symbol);
+    size_t index;
+
+    memset(&details, 0, sizeof(details));
+    if (address == NULL || dladdr(address, &details) == 0 || details.dli_fname == NULL) {
+        (void)amdl_native_write_literal(STDERR_FILENO, lookup_failure);
+        return 0;
+    }
+    basename = strrchr(details.dli_fname, '/');
+    basename = basename == NULL ? details.dli_fname : basename + 1;
+    for (index = 0; index < expected_count; ++index) {
+        if (strcmp(basename, expected[index]) == 0) {
+            return amdl_native_write_provider(expected[index]);
+        }
+    }
+    (void)amdl_native_write_literal(STDERR_FILENO, owner_failure);
+    return 0;
+}
+
+static const char *const amdl_native_http_message_provider_names[] = {
+    "libandroidappmusic.so",
+};
+
+static const char *const amdl_native_url_request_d2_provider_names[] = {
+    "libandroidappmusic.so",
+    "libstoreservicescore.so",
+};
+
+static const char *const amdl_native_store_error_code_provider_names[] = {
+    "libstoreservicescore.so",
+};
+
+static int amdl_native_initialise_product_defaults(char **device_copy) {
+    char *harness_argv[] = {"amdl-native-abi-harness", NULL};
+    int count;
+    int index;
+
+    if (device_copy == NULL) {
+        return 0;
+    }
+    *device_copy = NULL;
+    cmdline_parser(1, harness_argv, &args_info);
+    if (args_info.base_dir_arg == NULL || args_info.device_info_arg == NULL) {
+        return 0;
+    }
+    count = split_string_safe(args_info.device_info_arg, "/", device_infos, 9,
+                              device_copy);
+    if (count != 9 || *device_copy == NULL) {
+        return 0;
+    }
+    for (index = 0; index < 9; ++index) {
+        if (device_infos[index] == NULL || device_infos[index][0] == '\0') {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static int amdl_native_two_factor_suffix_cycle(void) {
+    struct amdl_native_two_factor_fixture {
+        unsigned char password[11];
+        unsigned char guard[16];
+    } fixture;
+    static const char first_code[7] = "123456";
+    static const char second_code[7] = "654321";
+    static const unsigned char expected_first[11] = "base123456";
+    static const unsigned char expected_second[11] = "base654321";
+    size_t index;
+    int result = 0;
+
+    memset(&fixture, 0, sizeof(fixture));
+    memcpy(fixture.password, "base", 4);
+    memset(fixture.guard, 0xa5, sizeof(fixture.guard));
+    amPassword = (char *)fixture.password;
+    amPasswordCapacity = sizeof(fixture.password);
+    amPasswordBaseLength = 4;
+    if (!amdl_apply_two_factor_code(first_code) ||
+        memcmp(fixture.password, expected_first, sizeof(expected_first)) != 0 ||
+        !amdl_apply_two_factor_code(second_code) ||
+        memcmp(fixture.password, expected_second, sizeof(expected_second)) != 0) {
+        goto cleanup;
+    }
+    for (index = 0; index < sizeof(fixture.guard); ++index) {
+        if (fixture.guard[index] != 0xa5) {
+            goto cleanup;
+        }
+    }
+    result = 1;
+
+cleanup:
+    amPassword = NULL;
+    amPasswordCapacity = 0;
+    amPasswordBaseLength = 0;
+    return result;
+}
+
+static int amdl_native_store_error_code_cycle(void) {
+    union amdl_native_store_error_fixture {
+        long double alignment;
+        unsigned char bytes[0x24];
+    } fixture;
+    static const uint32_t sentinels[] = {UINT32_C(0xa1b2c3d4), UINT32_C(0x5e4d3c2b)};
+    uint32_t observed = 0;
+    size_t index;
+
+    if (amdl_store_error_code_value(NULL, &observed) ||
+        amdl_store_error_code_value(fixture.bytes, NULL)) {
+        return 0;
+    }
+    for (index = 0; index < sizeof(sentinels) / sizeof(sentinels[0]); ++index) {
+        memset(&fixture, 0, sizeof(fixture));
+        memcpy(fixture.bytes + 0x20, &sentinels[index], sizeof(sentinels[index]));
+        observed = 0;
+        if (!amdl_store_error_code_value(fixture.bytes, &observed) ||
+            observed != sentinels[index]) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static int amdl_harness_counts_match(unsigned long expected_messages,
+                                     unsigned long expected_requests) {
+    return amdl_harness_http_message_created == expected_messages &&
+           amdl_harness_http_message_released == expected_messages &&
+           amdl_harness_url_request_created == expected_requests &&
+           amdl_harness_url_request_destroyed == expected_requests;
+}
+
+static int amdl_native_set_post_fields(struct amdl_http_message *message) {
+    union std_string header_name = new_std_string("Content-Type");
+    union std_string header_value = new_std_string("application/json");
+    static const char body[] = "{}";
+
+    return amdl_http_message_set_header(message, &header_name, &header_value) &&
+           amdl_http_message_set_body_data(message, body, sizeof(body) - 1);
+}
+
+static struct amdl_http_message *amdl_native_create_message_at(const char *url_text,
+                                                               int post) {
+    union std_string url;
+    union std_string method = new_std_string(post ? "POST" : "GET");
+    struct amdl_http_message *message;
+
+    if (url_text == NULL) {
+        return NULL;
+    }
+    url = new_std_string(url_text);
+    message = amdl_http_message_create(&url, &method);
