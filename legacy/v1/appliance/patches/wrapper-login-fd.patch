+static void wipe_memory(void *buffer, size_t length) {
+    volatile unsigned char *cursor = (volatile unsigned char *)buffer;
+    while (length-- > 0) {
+        *cursor++ = 0;
+    }
+}
+
+static void amdl_write_literal(const char *literal, size_t length) {
+    if (literal == NULL) {
+        return;
+    }
+    while (length > 0) {
+        ssize_t written = write(STDERR_FILENO, literal, length);
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        if (written <= 0) {
+            return;
+        }
+        literal += (size_t)written;
+        length -= (size_t)written;
+    }
+}
+
+static void amdl_log_data_view_failure(const char *stage, int reason) {
+    static const char *const suffixes[] = {
+        "ok\n",
+        "invalid_argument\n",
+        "length_exception\n",
+        "bytes_exception\n",
+        "bytes_null\n",
+    };
+    if (stage == NULL) {
+        return;
+    }
+    amdl_write_literal(stage, strlen(stage));
+    if (reason < 0 || reason >= (int)(sizeof(suffixes) / sizeof(suffixes[0]))) {
+        reason = 1;
+    }
+    amdl_write_literal(suffixes[reason], strlen(suffixes[reason]));
+}
+
+static void wipe_cjson_string(cJSON *item) {
+    if (cJSON_IsString(item) && item->valuestring != NULL) {
+        wipe_memory(item->valuestring, strlen(item->valuestring) + 1);
+    }
+}
+
+static void wipe_login_credentials(void) {
+    if (amUsername != NULL) {
+        wipe_memory(amUsername, amUsernameCapacity);
+        free(amUsername);
+        amUsername = NULL;
+    }
+    if (amPassword != NULL) {
+        wipe_memory(amPassword, amPasswordCapacity);
+        free(amPassword);
+        amPassword = NULL;
+    }
+    amUsernameCapacity = 0;
+    amPasswordCapacity = 0;
+    amPasswordBaseLength = 0;
+}
+
+static int read_two_factor_code_file(const char *path, char code[7]) {
+    if (path == NULL || code == NULL) {
+        return -1;
+    }
+    int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        return errno == ENOENT ? 0 : -1;
+    }
+    struct stat info = {0};
+    if (fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) || info.st_size != 6) {
+        close(fd);
+        unlink(path);
+        return -1;
+    }
+    size_t used = 0;
+    while (used < 7) {
+        ssize_t count = read(fd, code + used, 7 - used);
+        if (count == 0) {
+            break;
+        }
+        if (count < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            close(fd);
+            wipe_memory(code, 7);
+            unlink(path);
+            return -1;
+        }
+        used += (size_t)count;
+    }
+    int close_result = close(fd);
+    int unlink_result = unlink(path);
+    if (close_result != 0 || unlink_result != 0 || used != 6) {
+        wipe_memory(code, 7);
+        return -1;
+    }
+    for (size_t index = 0; index < 6; ++index) {
+        if (code[index] < '0' || code[index] > '9') {
+            wipe_memory(code, 7);
+            return -1;
+        }
+    }
+    code[6] = '\0';
+    return 1;
+}
+
+static int amdl_apply_two_factor_code(const char code[7]) {
+    const size_t passLen = amPasswordBaseLength;
+    size_t index;
+
+    if (amPassword == NULL || code == NULL || passLen > SIZE_MAX - 6 ||
+        passLen + 6 >= amPasswordCapacity || code[6] != '\0') {
+        return 0;
+    }
+    for (index = 0; index < 6; ++index) {
+        if (code[index] < '0' || code[index] > '9') {
+            return 0;
+        }
+    }
+    memcpy(amPassword + passLen, code, 6);
+    amPassword[passLen + 6] = '\0';
+    return 1;
+}
+
+/* Native startup markers contain fixed stage labels only. They exist so an
+ * initialization watchdog can name the stage that
+ * stopped instead of reporting an unlocatable silent timeout. */
+static void amdl_startup_marker(const char *stage) {
+    if (stage == NULL) {
+        return;
+    }
+    fprintf(stderr, "[wrapper-native] startup %s\n", stage);
+    fflush(stderr);
+}
+
+static int read_login_fd_credentials(void) {
+    const char *raw_fd = getenv("AMDL_WRAPPER_LOGIN_FD");
+    if (raw_fd == NULL || *raw_fd == '\0') {
+        return 0;
+    }
+    char *end = NULL;
+    errno = 0;
+    long parsed = strtol(raw_fd, &end, 10);
+    unsetenv("AMDL_WRAPPER_LOGIN_FD");
+    if (errno != 0 || end == raw_fd || *end != '\0' || parsed < 3 || parsed > 1024) {
+        fprintf(stderr, "[!] invalid login credential descriptor\n");
+        return -1;
+    }
+
+    int fd = (int)parsed;
+    unsigned char *document = calloc(AMDL_LOGIN_DOCUMENT_MAX + 2, 1);
+    if (document == NULL) {
+        close(fd);
+        return -1;
+    }
+    amdl_startup_marker("login_fd_read_begin");
+    size_t used = 0;
+    while (used <= AMDL_LOGIN_DOCUMENT_MAX) {
+        ssize_t count = read(fd, document + used, AMDL_LOGIN_DOCUMENT_MAX + 1 - used);
+        if (count == 0) {
+            break;
+        }
+        if (count < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            close(fd);
+            wipe_memory(document, AMDL_LOGIN_DOCUMENT_MAX + 2);
+            free(document);
+            return -1;
+        }
+        used += (size_t)count;
+    }
+    close(fd);
+    amdl_startup_marker("login_fd_eof");
+    if (used == 0 || used > AMDL_LOGIN_DOCUMENT_MAX) {
+        fprintf(stderr, "[!] login credential document has an invalid size\n");
+        wipe_memory(document, AMDL_LOGIN_DOCUMENT_MAX + 2);
+        free(document);
+        return -1;
+    }
+
+    cJSON *root = cJSON_Parse((const char *)document);
+    cJSON *email = root ? cJSON_GetObjectItemCaseSensitive(root, "appleEmail") : NULL;
+    cJSON *password = root ? cJSON_GetObjectItemCaseSensitive(root, "applePassword") : NULL;
+    if (!cJSON_IsString(email) || !cJSON_IsString(password) ||
+        email->valuestring == NULL || password->valuestring == NULL ||
+        *email->valuestring == '\0' || *password->valuestring == '\0') {
+        fprintf(stderr, "[!] login credential document is incomplete\n");
+        wipe_cjson_string(email);
+        wipe_cjson_string(password);
+        cJSON_Delete(root);
+        wipe_memory(document, AMDL_LOGIN_DOCUMENT_MAX + 2);
+        free(document);
+        return -1;
+    }
+    amUsernameCapacity = strlen(email->valuestring) + 1;
+    amUsername = strdup(email->valuestring);
+    size_t password_length = strlen(password->valuestring);
+    amPasswordCapacity = password_length + 7;
+    amPassword = calloc(password_length + 7, 1);
+    if (amUsername != NULL && amPassword != NULL) {
+        memcpy(amPassword, password->valuestring, password_length);
+        amPasswordBaseLength = password_length;
+    }
+    wipe_cjson_string(email);
+    wipe_cjson_string(password);
+    cJSON_Delete(root);
+    wipe_memory(document, AMDL_LOGIN_DOCUMENT_MAX + 2);
+    free(document);
+    if (amUsername == NULL || amPassword == NULL) {
+        fprintf(stderr, "[!] failed to allocate login credentials\n");
+        wipe_login_credentials();
+        return -1;
+    }
+    amdl_startup_marker("login_document_valid");
+    return 1;
+}
