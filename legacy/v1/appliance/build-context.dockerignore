# The context builder deliberately installs this reviewed file after copying
# the backend. It is the sole config.yaml allowed into an Appliance build.
!backend/config.yaml

# Fixed, test-only CA material used only by the non-deliverable Wrapper build
# gate. The runtime stage never copies this directory.
!network-preflight-fixtures/
!network-preflight-fixtures/*.crt
!network-preflight-fixtures/*.key
