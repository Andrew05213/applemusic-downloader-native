# This file is optional. Copy it to .env only when you need to provide local
# settings. Do not commit .env or share its contents.

# Docker Compose mounts this ignored file read-only instead of copying its
# secret values into container Config.Env. Keep this self-reference unchanged
# after copying the example to .env. Advanced users may point it at a different
# protected dotenv file.
AMDL_DOCKER_CREDENTIALS_FILE=./.env

# Apple ID credentials are required for wrapper-backed qualities (ALAC, AAC and
# Atmos). Leave both values empty to start the Web service without a wrapper.
APPLE_EMAIL=
APPLE_PASSWORD=

# Required for AAC-LC downloads and lyrics. Obtain this value from an Apple
# Music session that you are authorised to use.
MEDIA_USER_TOKEN=

# Optional API overrides. Leave AUTHORIZATION_TOKEN blank to allow the
# downloader to obtain one where supported. STOREFRONT is a two-letter code.
AUTHORIZATION_TOKEN=
STOREFRONT=us

# Protects the local Job API from unrelated processes and other OS users.
# Use exactly 64 hexadecimal characters (for example: openssl rand -hex 32).
# When omitted, Docker/native serve creates data/api-access-token with private
# permissions; the Web UI keeps the entered key only in the current page's
# memory and sends it as a Bearer header (never a cookie or URL parameter).
AMDL_API_TOKEN=

# Host paths persisted by Docker Compose. Relative paths are resolved from the
# directory containing docker-compose.yml. SQLite and the generated local API
# key intentionally use the private `amdl-data` Docker volume; a Windows bind
# mount cannot preserve their required owner/mode boundary.
DOWNLOADS_DIR=./downloads
WRAPPER_DATA_DIR=./wrapper-data

# Optional host port for Docker Web. The service remains bound to 127.0.0.1.
AMDL_HOST_PORT=8080
