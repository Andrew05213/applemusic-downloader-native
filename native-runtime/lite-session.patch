+// Native CBCS sample operation: preserve the context for one owned stream.
+// The persistent /key payload is deliberately not interpreted as AES bytes.
+struct NativeStream { std::string adam, uri; void* kd; };
+static std::map<std::string, NativeStream> native_streams;
+bool native_decrypt(const std::string& stream, const std::string& adam,
+                    const std::string& uri, const std::string& input,
+                    std::string& output) {
+    std::lock_guard<std::mutex> lock(g_playback_mutex);
+    auto found = native_streams.find(stream);
+    if (found == native_streams.end() || found->second.adam != adam || found->second.uri != uri) {
+        if (found == native_streams.end() && native_streams.size() >= 32) return false;
+        if (adam != "0" && uri == "skd://itunes.apple.com/P000000000/s1/e1") return false;
+        void* ptr = getKdContext(adam, uri);
+        if (!ptr || !*(void**)ptr) return false;
+        native_streams[stream] = NativeStream{adam, uri, *(void**)ptr};
+        found = native_streams.find(stream);
+    }
+    output = input;
+    NfcRKVnxuKZy04KWbdFu71Ou(found->second.kd, 5, &output[0], &output[0], output.size());
+    return true;
+}
+void native_decrypt_close(const std::string& stream) {
+    std::lock_guard<std::mutex> lock(g_playback_mutex);
+    native_streams.erase(stream);
+}
